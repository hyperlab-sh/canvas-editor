---
// The landing page. It shows the product in the order every public surface
// tells it (agent → text and canvas → repo map → export), using the real app's
// screenshots (scripts/capture-screens.mjs) and the docs' own compiled
// examples (scripts/build-examples.mts), never a mock-up. Plain HTML and CSS;
// the only script copies the install line and replays the motion sample.
import { existsSync, readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';
import '../styles/custom.css';
import SiteFooter from '../components/SiteFooter.astro';
import { APP_URL, MCP_COMMAND, REPO_URL, SAMPLE_MAP_URL } from '../components/links';
import { findExamples, hashExample } from '../../scripts/example-blocks.mjs';

const TITLE = 'OpenFlowKit — Architecture diagrams you draw, write as code, or hand to your agent';
const TAGLINE = 'Architecture diagrams you draw, write as code, or hand to your agent.';
const SUBLINE = 'Free, open source and local-first. Paste a GitHub repo and get its map, every arrow cited to a line of code.';
const SITE = 'https://docs.openflowkit.com';

// The build runs from docs-site/ (npm workspace script), after prebuild wrote
// public/examples; screenshots are committed under public/screens.
const PUBLIC = resolve(process.cwd(), 'public');
const DOCS = resolve(process.cwd(), 'src', 'content', 'docs');

interface Shot {
  readonly light: string;
  readonly dark: string;
  readonly width: number;
  readonly height: number;
}

/** A light/dark screenshot pair, or null when it has not been captured yet. */
async function shot(name: string): Promise<Shot | null> {
  const light = resolve(PUBLIC, 'screens', `${name}-light.webp`);
  if (!existsSync(light) || !existsSync(resolve(PUBLIC, 'screens', `${name}-dark.webp`))) return null;
  const { width = 2880, height = 1800 } = await sharp(light).metadata();
  return { light: `/screens/${name}-light.webp`, dark: `/screens/${name}-dark.webp`, width, height };
}

const heroShot = (await shot('agent')) ?? (await shot('editor'));
const mapShot = await shot('map');

interface ExampleView {
  readonly light: string;
  readonly dark: string;
  readonly width: number;
  readonly height: number;
}

const manifest: Record<string, { family: string; views: ExampleView[] }> =
  JSON.parse(readFileSync(resolve(PUBLIC, 'examples', 'examples.json'), 'utf8'));

/** A docs page's first compiled example: its source and its rendered view. */
function firstExample(slug: string): { source: string; view: ExampleView } | null {
  const file = resolve(DOCS, `${slug}.md`);
  if (!existsSync(file)) return null;
  const [example] = findExamples(readFileSync(file, 'utf8'));
  const view = example && manifest[hashExample(example.source)]?.views[0];
  return view ? { source: example.source.trim(), view } : null;
}

const TYPES = [
  ['diagram-flowchart', 'Flowchart'],
  ['diagram-architecture', 'Architecture'],
  ['diagram-sequence', 'Sequence'],
  ['diagram-state', 'State'],
  ['diagram-erd', 'ERD'],
  ['diagram-class', 'Class'],
  ['diagram-mindmap', 'Mind map'],
  ['diagram-gitgraph', 'Git graph'],
  ['diagram-chart', 'Chart'],
  ['diagram-wireframe', 'Wireframe'],
] as const;
const gallery = TYPES.flatMap(([slug, label]) => {
  const example = firstExample(slug);
  return example ? [{ slug, label, view: example.view }] : [];
});

const textExample = firstExample('diagram-architecture') ?? firstExample('diagram-flowchart');
// The same diagram, animated by the app's exporter (scripts/build-examples.mts).
const motion = textExample && existsSync(resolve(PUBLIC, 'examples', 'motion-light.svg')) ? textExample.view : null;

/** Just enough colour to read the DSL: family line, attributes, arrows, labels. */
function highlight(source: string): string {
  const escape = (text: string) => text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);
  return source.split('\n').map((line, index) => {
    if (index === 0) return line.replace(/^(\S+)(.*)$/, (_, family, rest) => `<span class="t-k">${escape(family)}</span>${escape(rest)}`);
    const [statement, ...label] = line.split(' : ');
    const body = escape(statement!)
      .replace(/(\[[^\]]*\])/g, '<span class="t-b">$1</span>')
      .replace(/ (-+&gt;+|=+&gt;) /g, ' <span class="t-a">$1</span> ');
    return label.length ? `${body} <span class="t-l">: ${escape(label.join(' : '))}</span>` : body;
  }).join('\n');
}

const MCP_CONFIG = `{
  "mcpServers": {
    "openflowkit": {
      "command": "npx",
      "args": ["-y", "openflowkit", "mcp"]
    }
  }
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={SUBLINE} />
    <link rel="canonical" href={`${SITE}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:site_name" content="OpenFlowKit" />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={SUBLINE} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={TAGLINE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={SUBLINE} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <meta name="theme-color" content="#f7f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191b19" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/inter-400-700-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      // Outside Starlight there is no theme picker: follow the OS, and honour a
      // choice made in the docs (Starlight stores it under this key).
      const stored = (() => { try { return localStorage.getItem('starlight-theme'); } catch { return null; } })();
      document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored
        : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav wrap">
      <a class="brand" href="/">
        <img src="/favicon.svg" alt="" width="24" height="24" />
        OpenFlowKit
      </a>
      <nav aria-label="Main">
        <a class="nav-link" href="/introduction/">Docs</a>
        <a class="nav-link wide-only" href="/mcp-server/">Agents</a>
        <a class="nav-icon" href={REPO_URL} aria-label="OpenFlowKit on GitHub" title="GitHub">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3" /></svg>
        </a>
        <a class="button button-primary button-small" href={APP_URL}>Open app</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero-copy">
          <h1>{TAGLINE}</h1>
          <p class="subline">{SUBLINE}</p>
          <div class="actions">
            <a class="button button-primary" href={APP_URL}>Open the app</a>
            <a class="button button-quiet" href="/quick-start/">Quick start</a>
          </div>
          <div class="install">
            <code><span class="prompt" aria-hidden="true">$</span> {MCP_COMMAND}</code>
            <button class="copy-button" type="button" data-copy={MCP_COMMAND} aria-label="Copy the MCP server command">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <p class="install-note">The MCP server, for Claude Code, Cursor and any other MCP client.</p>
        </div>
        {heroShot && (
          <figure class="wrap shot hero-shot">
            <div class="frame">
              <img class="ofk-screen-light" src={heroShot.light} width={heroShot.width} height={heroShot.height} fetchpriority="high"
                alt="The OpenFlowKit editor: an architecture diagram on the canvas beside the panel that drew it" />
              <img class="ofk-screen-dark" src={heroShot.dark} width={heroShot.width} height={heroShot.height}
                alt="The OpenFlowKit editor in dark mode: an architecture diagram on the canvas beside the panel that drew it" />
            </div>
          </figure>
        )}
      </section>

      <section class="band wrap" aria-labelledby="agent-title">
        <div class="split">
          <div class="copy">
            <p class="eyebrow">Agents &amp; MCP</p>
            <h2 id="agent-title">Your agent draws on your canvas, live.</h2>
            <p>
              Connect Claude Code, Cursor or any MCP client. It reads the page, draws, restyles and takes a
              screenshot to check its own work, on the diagram you have open. Every change it makes is one undo step.
            </p>
            <ul class="points">
              <li>29 tools: create, update, style, export, screenshot.</li>
              <li>No app open? It edits <code>.openflow.json</code> files in your repo instead.</li>
              <li>No API key of its own. Your client's model does the thinking.</li>
              <li>In claude.ai or ChatGPT? Add the connector <code>https://mcp.openflowkit.com/mcp</code>: no install, and diagrams appear as cards in the chat.</li>
            </ul>
            <a class="more" href="/connect-your-agent/">Connect your agent <span aria-hidden="true">→</span></a>
          </div>
          <div class="panel code-card" role="group" aria-label="MCP client setup">
            <div class="code-head">Claude Code</div>
            <pre><code><span class="t-l">$</span> claude mcp add -s user openflowkit -- {MCP_COMMAND}</code></pre>
            <div class="code-head">Cursor, Windsurf, VS Code, Claude Desktop</div>
            <pre class="config"><code>{MCP_CONFIG}</code></pre>
            <p class="code-foot">Then open the app and click <strong>Connect agent</strong>. It shows the exact steps for your client.</p>
          </div>
        </div>
      </section>

      {textExample && (
        <section class="band wrap" aria-labelledby="text-title">
          <div class="head">
            <p class="eyebrow">Text and canvas</p>
            <h2 id="text-title">Write it as text. Drag it on the canvas.</h2>
            <p>
              One small language for ten diagram types. Press <kbd>⌥C</kbd> for the code panel, change a line, and
              <kbd>⌘↵</kbd> redraws the frame. Import Mermaid, D2 or Structurizr and it converts.
            </p>
            <a class="more" href="/openflow-dsl/">The OpenFlow DSL <span aria-hidden="true">→</span></a>
          </div>
          <figure class="panel duo">
            <pre class="duo-source"><code set:html={highlight(textExample.source)} /></pre>
            <div class="duo-render canvas">
              <img class="ofk-example-light" src={`/examples/${textExample.view.light}`} width={textExample.view.width} height={textExample.view.height} loading="lazy" decoding="async"
                alt="The architecture diagram compiled from the source beside it" />
              <img class="ofk-example-dark" src={`/examples/${textExample.view.dark}`} width={textExample.view.width} height={textExample.view.height} loading="lazy" decoding="async"
                alt="The architecture diagram compiled from the source beside it" />
            </div>
            <figcaption>Compiled from this source by the app's own compiler when this page was built.</figcaption>
          </figure>
        </section>
      )}

      <section class="band wrap" aria-labelledby="map-title">
        <div class="head">
          <p class="eyebrow">Repo maps</p>
          <h2 id="map-title">Paste a GitHub repo. Get its map.</h2>
          <p>
            Your browser reads a GitHub repository (a private one with your token) and draws its services and how they connect. Open an arrow to
            see the file and line it came from. No AI key needed.
          </p>
          <div class="links">
            <a class="button button-quiet" href={SAMPLE_MAP_URL}>Try it on a sample repo</a>
            <a class="more" href="/map-mode/">How repo maps work <span aria-hidden="true">→</span></a>
          </div>
        </div>
        {mapShot && (
          <figure class="shot">
            <div class="frame">
              <img class="ofk-screen-light" src={mapShot.light} width={mapShot.width} height={mapShot.height} loading="lazy" decoding="async"
                alt="A repository's map in OpenFlowKit, one box opened in place beside a card listing what it talks to" />
              <img class="ofk-screen-dark" src={mapShot.dark} width={mapShot.width} height={mapShot.height} loading="lazy" decoding="async"
                alt="A repository's map in OpenFlowKit in dark mode, one box opened in place beside a card listing what it talks to" />
            </div>
          </figure>
        )}
      </section>

      <section class="band wrap" aria-labelledby="types-title">
        <div class="head">
          <p class="eyebrow">Diagram types</p>
          <h2 id="types-title">Ten diagram types, one language.</h2>
          <p>Each picture is the first example on its page, compiled by the same code the app runs.</p>
        </div>
        <ul class="gallery">
          {gallery.map(({ slug, label, view }) => (
            <li>
              <a href={`/${slug}/`}>
                <span class="thumb canvas">
                  <img class="ofk-example-light" src={`/examples/${view.light}`} width={view.width} height={view.height} loading="lazy" decoding="async" alt="" />
                  <img class="ofk-example-dark" src={`/examples/${view.dark}`} width={view.width} height={view.height} loading="lazy" decoding="async" alt="" />
                </span>
                <span class="thumb-label">{label}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="band wrap" aria-labelledby="export-title">
        <div class="split">
          <div class="copy">
            <p class="eyebrow">Export and motion</p>
            <h2 id="export-title">Export it, or let it move.</h2>
            <p>
              PNG, SVG, PDF and JSON for docs and slides. Animate a page and export it as SVG, GIF, MP4 or WebM,
              rendered in your browser.
            </p>
            <div class="links">
              <a class="more" href="/exporting/">Exporting <span aria-hidden="true">→</span></a>
              <a class="more" href="/animated-export/">Animated export <span aria-hidden="true">→</span></a>
            </div>
          </div>
          {motion && (
            <figure class="panel motion">
              <img class="ofk-example-light" src="/examples/motion-light.svg" width={motion.width} height={motion.height} loading="lazy" decoding="async" data-replay
                alt="The architecture diagram above, building itself one step at a time: an animated SVG exported by OpenFlowKit" />
              <img class="ofk-example-dark" src="/examples/motion-dark.svg" width={motion.width} height={motion.height} loading="lazy" decoding="async" data-replay
                alt="The architecture diagram above, building itself one step at a time: an animated SVG exported by OpenFlowKit" />
              <figcaption>The diagram above as an animated SVG, straight from the exporter. It plays each time it scrolls into view.</figcaption>
            </figure>
          )}
        </div>
      </section>

      <section class="band wrap" aria-labelledby="privacy-title">
        <div class="split">
          <div class="copy">
            <p class="eyebrow">Privacy</p>
            <h2 id="privacy-title">Your diagrams stay in your browser.</h2>
            <p>Something leaves it only when you choose. No account needed.</p>
            <a class="more" href="/local-first-diagramming/">What local-first means here <span aria-hidden="true">→</span></a>
          </div>
          <dl class="panel leaves">
            <div><dt>AI with your own key</dt><dd>goes to that provider</dd></div>
            <div><dt>A share link</dt><dd>uploads an encrypted copy</dd></div>
            <div><dt>A repo map</dt><dd>reads from GitHub</dd></div>
            <div><dt>Usage stats</dt><dd>help us improve; off in Settings</dd></div>
          </dl>
        </div>
      </section>

      <section class="closing wrap">
        <h2>Draw your first diagram.</h2>
        <p>Nothing to install. Free and MIT licensed.</p>
        <div class="actions">
          <a class="button button-primary" href={APP_URL}>Open the app</a>
          <a class="button button-quiet" href={REPO_URL}>Star on GitHub</a>
        </div>
      </section>
    </main>

    <div class="wrap footer-wrap">
      <SiteFooter />
    </div>

    <script>
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        button.addEventListener('click', async () => {
          const label = button.querySelector('[data-copy-label]')!;
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            label.textContent = 'Copied';
          } catch {
            label.textContent = 'Select and copy';
          }
          setTimeout(() => { label.textContent = 'Copy'; }, 1600);
        });
      }
      // An animated SVG plays once, from when it loads; start it again each time
      // it scrolls into view so the reader sees it from the beginning.
      const replay = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          // A new query is a new image document, so the animation starts over
          // (a changed #fragment reuses the running one).
          const image = entry.target as HTMLImageElement;
          image.src = `${image.src.split('?')[0]}?play=${Date.now()}`;
        }
      }, { threshold: 0.5 });
      // Under reduced motion the file shows its finished still; nothing to replay.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const image of document.querySelectorAll('[data-replay]')) replay.observe(image);
      }
    </script>

    <style>
      html {
        scroll-padding-top: 1rem;
      }
      body {
        margin: 0;
        color: var(--sl-color-text);
        font: 400 1rem/1.6 var(--sl-font);
        background: var(--ofk-canvas);
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      kbd {
        padding: 0.05rem 0.35rem;
        border: 1px solid var(--ofk-border);
        border-radius: 6px;
        background: var(--ofk-surface);
        font: 500 0.85em/1.4 var(--sl-font);
        color: var(--ofk-text);
      }
      :focus-visible {
        outline: 2px solid var(--ofk-text);
        outline-offset: 2px;
        border-radius: 6px;
      }
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        padding: 0.5rem 0.75rem;
        background: var(--ofk-surface);
        border-radius: 8px;
      }
      .wrap {
        box-sizing: border-box;
        width: 100%;
        max-width: 72rem;
        margin-inline: auto;
        padding-inline: 1rem;
      }

      /* ---- Nav ---- */
      .nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        height: 4rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--ofk-text);
      }
      .nav nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.875rem;
        font-weight: 500;
      }
      .nav-link {
        padding: 0.5rem 0.625rem;
        border-radius: 8px;
        transition: background-color 150ms ease, color 150ms ease;
      }
      .nav-icon {
        display: grid;
        place-items: center;
        width: 2.25rem;
        height: 2.25rem;
        margin-inline-end: 0.25rem;
        border-radius: 8px;
        color: var(--ofk-text);
        transition: background-color 150ms ease;
      }

      /* ---- Buttons ---- */
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 2.75rem;
        padding: 0 1.125rem;
        border-radius: 10px;
        font-size: 0.9375rem;
        font-weight: 600;
        white-space: nowrap;
        transition: background-color 150ms ease, border-color 150ms ease, transform 120ms var(--ofk-ease);
      }
      .button:active,
      .copy-button:active {
        transform: scale(0.97);
      }
      .button-small {
        height: 2.25rem;
        padding: 0 0.875rem;
        border-radius: 8px;
        font-size: 0.875rem;
      }
      .button-primary {
        background: var(--ofk-primary);
        color: var(--ofk-on-primary);
      }
      .button-quiet {
        border: 1px solid var(--ofk-border);
        background: var(--ofk-surface);
        color: var(--ofk-text);
      }
      @media (hover: hover) {
        .nav-link:hover,
        .nav-icon:hover {
          background: var(--ofk-raised);
          color: var(--ofk-text);
        }
        .button-primary:hover {
          background: var(--ofk-primary-hover);
        }
        .button-quiet:hover {
          border-color: var(--ofk-border-strong);
        }
        .more:hover {
          text-decoration-color: currentColor;
        }
        .gallery a:hover .thumb {
          border-color: var(--ofk-border-strong);
        }
        .copy-button:hover {
          background: var(--ofk-raised);
          color: var(--ofk-text);
        }
      }

      /* ---- Hero ---- */
      .hero {
        position: relative;
        padding-top: 3.5rem;
      }
      /* The canvas's dot grid, fading out under the headline. */
      .hero::before {
        content: '';
        position: absolute;
        inset: 0 0 30% 0;
        z-index: -1;
        background-image: radial-gradient(circle, var(--ofk-dot) 1px, transparent 1.2px);
        background-size: 20px 20px;
        -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
        mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
      }
      .hero-copy {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
      h1 {
        max-width: 15em;
        margin: 0;
        font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
        font-weight: 650;
        line-height: 1.04;
        letter-spacing: -0.04em;
        color: var(--ofk-text);
        text-wrap: balance;
      }
      .subline {
        max-width: 34rem;
        margin: 1.25rem 0 0;
        font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
        line-height: 1.55;
        text-wrap: pretty;
      }
      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 2rem;
      }
      .install {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        max-width: 100%;
        margin-top: 1.5rem;
        padding: 0.25rem 0.25rem 0.25rem 0.875rem;
        border: 1px solid var(--ofk-border);
        border-radius: 10px;
        background: var(--ofk-surface);
      }
      .install code {
        min-width: 0;
        overflow-x: auto;
        font: 0.8125rem/1.5 var(--sl-font-mono);
        color: var(--ofk-text);
        white-space: nowrap;
        scrollbar-width: none;
      }
      .prompt {
        color: var(--ofk-muted);
        user-select: none;
      }
      .copy-button {
        display: inline-flex;
        flex-shrink: 0;
        align-items: center;
        gap: 0.35rem;
        height: 2rem;
        padding: 0 0.625rem;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: var(--ofk-muted);
        font: 500 0.8125rem/1 var(--sl-font);
        cursor: pointer;
        transition: background-color 150ms ease, color 150ms ease, transform 120ms var(--ofk-ease);
      }
      .install-note {
        margin: 0.625rem 0 0;
        font-size: 0.8125rem;
        color: var(--ofk-muted);
      }
      .shot {
        margin: 0 auto;
      }
      .hero-shot {
        margin-top: 3.5rem;
      }
      .frame {
        overflow: hidden;
        border: 1px solid var(--ofk-border);
        border-radius: 16px;
        background: var(--ofk-surface);
        box-shadow: var(--ofk-shadow-overlay);
        line-height: 0;
      }
      .frame img {
        width: 100%;
        height: auto;
      }

      /* ---- Bands ---- */
      .band {
        margin-top: clamp(5rem, 4rem + 4vw, 8rem);
      }
      .eyebrow {
        margin: 0 0 0.75rem;
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--ofk-primary);
      }
      h2 {
        margin: 0;
        font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.25rem);
        font-weight: 650;
        line-height: 1.12;
        letter-spacing: -0.03em;
        color: var(--ofk-text);
        text-wrap: balance;
      }
      .copy > p:not(.eyebrow),
      .head > p:not(.eyebrow) {
        max-width: 34rem;
        margin: 1rem 0 0;
        font-size: 1.0625rem;
        line-height: 1.6;
        text-wrap: pretty;
      }
      .head {
        max-width: 40rem;
        margin-bottom: 2.5rem;
      }
      .head .links,
      .copy .links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem 1.5rem;
        margin-top: 1.5rem;
      }
      .more {
        display: inline-block;
        margin-top: 1.25rem;
        font-weight: 600;
        font-size: 0.9375rem;
        color: var(--ofk-text);
        text-decoration: underline;
        text-decoration-color: var(--ofk-border-strong);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.25em;
        transition: text-decoration-color 150ms ease;
      }
      .links .more {
        margin-top: 0;
      }
      .copy code,
      .points code {
        padding: 0.05rem 0.3rem;
        border: 1px solid var(--ofk-border);
        border-radius: 6px;
        background: var(--ofk-raised);
        font: 0.85em var(--sl-font-mono);
        color: var(--ofk-text);
        overflow-wrap: anywhere;
      }
      .points {
        display: grid;
        gap: 0.5rem;
        margin: 1.25rem 0 0;
        padding: 0;
        list-style: none;
      }
      .points li {
        position: relative;
        padding-left: 1.25rem;
      }
      .points li::before {
        content: '';
        position: absolute;
        left: 0.25rem;
        top: 0.7em;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ofk-border-strong);
      }
      .split {
        display: grid;
        gap: 2.5rem;
        align-items: center;
      }
      .panel {
        margin: 0;
        border: 1px solid var(--ofk-border);
        border-radius: 16px;
        background: var(--ofk-surface);
      }
      .canvas {
        background-color: var(--ofk-canvas);
        background-image: radial-gradient(circle, var(--ofk-dot) 1px, transparent 1.2px);
        background-size: 16px 16px;
      }

      /* Agent setup card */
      .code-card {
        min-width: 0;
        padding: 0.5rem;
      }
      .code-head {
        padding: 0.75rem 0.75rem 0.5rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--ofk-muted);
      }
      .code-card pre,
      .duo-source {
        margin: 0;
        font: 0.8125rem/1.7 var(--sl-font-mono);
        color: var(--ofk-text);
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }
      .code-card pre {
        padding: 0.75rem 0.875rem;
        border-radius: 10px;
        background: var(--ofk-canvas);
      }
      /* JSON keeps its shape and scrolls on a phone rather than breaking a string. */
      .code-card pre.config {
        white-space: pre;
        overflow-x: auto;
        overflow-wrap: normal;
      }
      .code-foot {
        margin: 0;
        padding: 0.875rem 0.75rem 0.5rem;
        font-size: 0.875rem;
        color: var(--ofk-muted);
      }
      .code-foot strong {
        color: var(--ofk-text);
        font-weight: 600;
      }

      /* Text ↔ canvas */
      .duo {
        display: grid;
        overflow: hidden;
      }
      .duo-source {
        padding: 1.5rem;
        white-space: pre;
        overflow-x: auto;
      }
      .duo-render {
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        border-top: 1px solid var(--ofk-border);
      }
      .duo-render img {
        max-width: 100%;
        height: auto;
      }
      .duo figcaption {
        grid-column: 1 / -1;
        padding: 0.75rem 1.5rem;
        border-top: 1px solid var(--ofk-border);
        font-size: 0.8125rem;
        color: var(--ofk-muted);
      }
      /* The highlighted DSL is set:html, so its spans carry no scope attribute. */
      :global(.t-k) {
        color: var(--ofk-primary);
        font-weight: 600;
      }
      :global(.t-b),
      :global(.t-l) {
        color: var(--ofk-muted);
      }
      :global(.t-a) {
        color: var(--ofk-primary);
      }

      /* Gallery */
      .gallery {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }
      .gallery a {
        display: grid;
        gap: 0.625rem;
      }
      .thumb {
        position: relative;
        aspect-ratio: 4 / 3;
        border: 1px solid var(--ofk-border);
        border-radius: 12px;
        transition: border-color 150ms ease;
      }
      .thumb img {
        position: absolute;
        inset: 0.625rem;
        width: calc(100% - 1.25rem);
        height: calc(100% - 1.25rem);
        object-fit: contain;
      }
      .thumb-label {
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--ofk-text);
      }

      /* Motion sample: the exported file on its own background, as it ships. */
      .motion {
        overflow: hidden;
      }
      .motion img {
        width: 100%;
        height: auto;
        vertical-align: top;
      }
      .motion figcaption {
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--ofk-border);
        font-size: 0.8125rem;
        color: var(--ofk-muted);
      }

      /* Privacy */
      .leaves {
        display: grid;
        padding: 0.5rem 1.25rem;
      }
      .leaves div {
        display: grid;
        gap: 0.125rem;
        padding: 1rem 0;
      }
      .leaves div + div {
        border-top: 1px solid var(--ofk-border);
      }
      .leaves dt {
        font-weight: 600;
        color: var(--ofk-text);
      }
      .leaves dd {
        margin: 0;
        color: var(--ofk-muted);
      }

      /* Closing */
      .closing {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: clamp(5rem, 4rem + 4vw, 8rem);
        padding-block: 3.5rem;
        text-align: center;
      }
      .closing p {
        margin: 0.75rem 0 0;
      }
      .closing .actions {
        margin-top: 1.5rem;
      }
      .footer-wrap {
        margin-top: 2rem;
        padding-bottom: 2.5rem;
      }

      @media (max-width: 30rem) {
        .wide-only {
          display: none;
        }
        .hero {
          padding-top: 2rem;
        }
        .hero-shot {
          margin-top: 2.5rem;
        }
        .frame {
          border-radius: 12px;
        }
      }
      @media (min-width: 40rem) {
        .gallery {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      @media (min-width: 56rem) {
        .split {
          grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
          gap: 4rem;
        }
        .duo {
          grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
        }
        .duo-render {
          border-top: 0;
          border-left: 1px solid var(--ofk-border);
        }
        .gallery {
          grid-template-columns: repeat(5, minmax(0, 1fr));
        }
      }
    </style>
  </body>
</html>
