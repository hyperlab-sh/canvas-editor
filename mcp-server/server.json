{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hyperlab-sh/canvas-mcp",
  "description": "Architecture diagrams for your agent: draw on the live Canvas editor or edit diagram files.",
  "repository": {
    "url": "https://github.com/hyperlab-sh/canvas-editor",
    "source": "github"
  },
  "version": "0.2.4",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@hyperlab.sh/canvas",
      "version": "0.2.4",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
